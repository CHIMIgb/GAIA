{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "moduleResolution": "bundler",
    /* `scripts/*.mjs` es JavaScript a propósito (lo corre node sin compilar),
       pero el spec lo importa y sin esto TS no encuentra sus tipos. */
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* El test E2E importa tipos de `src/`, que a su vez consume `@gaia/shared`
       como fuente. Mismo motivo y misma razón que en tsconfig.app.json. */
    "paths": {
      "@gaia/shared": ["../shared/src/index.ts"]
    }
  },
  "include": [
    "playwright.config.ts",
    "playwright.fcp.config.ts",
    "tests/e2e",
    "tests/fcp"
  ]
}
