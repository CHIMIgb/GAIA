{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* El test E2E importa tipos de `src/`, que a su vez consume `@gaia/shared`
       como fuente. Mismo motivo y misma razón que en tsconfig.app.json. */
    "paths": {
      "@gaia/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["playwright.config.ts", "tests/e2e"]
}
